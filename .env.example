# Requerida para que el Core Cognitivo de Snarf razone (Capacidad: AnthropicLLM).
# Sin esta variable, Snarf corre en modo eco (ver COGNITION.md).
# Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Requerida para el canal de voz, tier PREMIUM únicamente (ver
# snarf/voice/config.yaml) — nunca se usa en conversación cotidiana, solo
# cuando se pide explícitamente o para un asset publicable. También la usa
# el dashboard para mostrar el cupo real de caracteres de la cuenta.
ELEVENLABS_API_KEY=

# voice_id de ElevenLabs que usa Snarf para hablar (ver elevenlabs.io/app/voice-library).
ELEVENLABS_VOICE_ID=

# Contraseña para entrar a la interfaz web de Snarf (ver web/login.html).
# Sin esta variable, el login siempre rechaza (falla cerrado, no abierto).
SNARF_ACCESS_PASSWORD=

# Secreto usado para firmar la cookie de sesión del login. Cualquier string
# largo y aleatorio sirve, por ejemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
# Sin esta variable, ningún endpoint protegido funciona (falla cerrado).
SESSION_SECRET=

# Requerida para generar embeddings al vectorizar Google Drive (Capacidad:
# VoyageEmbeddings, modelo voyage-4-lite). Sin esta variable, la indexación
# de Drive no está disponible. Se obtiene en https://dashboard.voyageai.com
VOYAGE_API_KEY=

# Requerida para el STT primario de la capa de voz (ver snarf/voice/config.yaml)
# — lo que Snarf entiende cuando le hablás. Groq (whisper-large-v3-turbo),
# ~USD 0.04/hora de audio, con tier gratuito diario amplio. Sin esta
# variable, cae directo al fallback local (faster-whisper, gratis pero más
# lento) si está instalado, o STT queda no disponible. Se obtiene en
# https://console.groq.com
GROQ_API_KEY=

# Opcionales — habilitan proveedores de LLM alternativos a Anthropic (ver
# snarf/runtime/llm_routing.py y el panel de configuración: "LLM por rol").
# Sin ninguna de estas, Snarf sigue funcionando exactamente igual que hoy —
# el default de cada rol (orchestrator, gmail_digest, drive_vision,
# project_summary, conversation_title) es Anthropic, sin excepción, hasta
# que se elija explícitamente otra cosa.
#
# Google Gemini. Se obtiene en https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# OpenAI real. Se obtiene en https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# xAI (Grok) — API compatible con el formato de OpenAI. Se obtiene en
# https://console.x.ai
XAI_API_KEY=
#
# Llama (open-weight) vía Groq no necesita una credencial nueva — reusa el
# mismo GROQ_API_KEY de más abajo (STT y ahora también texto).

# Ninguna variable de entorno controla el tier LOCAL de TTS (Kokoro) — su
# configuración (URL del contenedor Docker, voz) vive enteramente en
# snarf/voice/config.yaml, no acá. Levantar el contenedor:
# docker compose -f docker-compose.voice.yml up -d

# Opcional — habilita las herramientas de Notion (notion_search,
# notion_read_page, notion_create_page, notion_append_to_page). Sin esta
# variable, esas herramientas devuelven un error explícito al fundador en
# vez de fallar en silencio o inventar resultados. Se crea una integración
# en https://www.notion.so/my-integrations, se copia el token acá, y hay
# que compartir manualmente (desde Notion) las páginas que Snarf deba poder
# ver — una integración nueva no tiene acceso a nada hasta que se comparte.
NOTION_API_KEY=

# Opcional — OAuth de Notion por usuario (Second Brain multi-usuario, ADR
# 0186). Distinto de NOTION_API_KEY de arriba (token fijo de integración
# interna, un solo workspace): esto permite que CUALQUIER usuario de Snarf
# conecte su propio Notion desde la interfaz (GET /auth/notion/start), sin
# compartir páginas a mano de antemano. Requiere registrar la integración de
# Snarf como PÚBLICA en https://www.notion.so/my-integrations (paso manual
# real, no automatizable) y dar de alta el redirect URI real
# (https://<dominio-o-tailscale>/auth/notion/callback). Mientras no esté
# configurado, cada usuario sigue cayendo de vuelta a NOTION_API_KEY si
# existe (comportamiento de siempre para el fundador).
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Opcional — habilita la búsqueda web real (Fase I, rama Research:
# research_deep_dive/research_trend_scan/research_competitor_watch). Sin
# esta variable, esos tools degradan honesto (nunca inventan una fuente) en
# vez de fallar en silencio. Se obtiene en https://tavily.com
TAVILY_API_KEY=

# Opcionales, las tres juntas — habilitan Discord (Fase I, rama Community:
# community_pulse/community_post_message). Sin cualquiera de las tres,
# `available` es False y esos tools devuelven un error explícito. Bot real
# creado en https://discord.com/developers/applications, invitado al
# servidor real con permisos de leer/escribir mensajes.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# Además de las variables de arriba, vectorizar contenido de video requiere
# el binario `ffmpeg` instalado en el sistema (no es un paquete de pip) para
# extraer la pista de audio antes de transcribirla. En macOS: `brew install
# ffmpeg`. Sin él, solo falla la indexación de archivos de video — el resto
# de tipos (PDF, imagen, audio) no lo necesita.

# PDF sin ninguna capa de texto real (un escaneo puro) cae a OCR con el
# binario `tesseract` (no es un paquete de pip). En macOS: `brew install
# tesseract`, más el paquete de idioma español (no viene con la instalación
# base): descargar `spa.traineddata` desde
# https://github.com/tesseract-ocr/tessdata_fast y copiarlo a
# `$(brew --prefix)/share/tessdata/`. Sin tesseract instalado, PdfExtractor
# sigue funcionando para PDFs con texto nativo — solo no hay fallback de OCR
# para los escaneados.
